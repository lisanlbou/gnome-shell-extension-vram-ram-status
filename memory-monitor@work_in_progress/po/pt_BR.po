msgstr[0] "%d segundo"
msgstr[1] "%d segundos"


msgid "Refresh interval"
msgstr "Intervalo de atualização"

msgid "About"
msgstr "Sobre"

msgid "Memory Monitor"
msgstr "Monitor de memória"

msgid "Displays system RAM and GPU memory from /proc/meminfo and sysfs. No network access, no root required."
msgstr "Exibe a memória RAM do sistema e da GPU a partir de /proc/meminfo e sysfs. Sem acesso à rede e sem necessidade de root."

msgid "Version"
msgstr "Versão"

msgid "Author"
msgstr "Autor"

msgid "GPU support"
msgstr "Suporte a GPU"

msgid "AMD dedicated VRAM is supported natively. Intel and NVIDIA are capability-detected and reported as unavailable when no supported backend is present."
msgstr "A VRAM dedicada da AMD é suportada nativamente. Intel e NVIDIA são detectadas por capacidade e informadas como indisponíveis quando não há um backend compatível."

