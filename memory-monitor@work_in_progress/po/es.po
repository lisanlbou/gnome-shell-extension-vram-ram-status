msgid "How RAM and VRAM are rendered in the panel."
msgstr "Cómo se muestran la RAM y la VRAM en el panel."

msgid "RAM format"
msgstr "Formato de RAM"

msgid "VRAM format"
msgstr "Formato de VRAM"

msgid "Metric order"
msgstr "Orden de las métricas"

msgid "Decimal precision"
msgstr "Precisión decimal"

msgid "Digits after the decimal point."
msgstr "Dígitos después del punto decimal."

